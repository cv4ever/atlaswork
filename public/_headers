# Cloudflare Pages response headers for app.atlaswork.app (README, "Releasing"). Sign-in tokens live in localStorage,
# so the Content-Security-Policy is the safety net against injected script: only this site's own scripts and
# Turnstile's run. Connections stay open to any https host because a customer's own AI provider can be any
# OpenAI-compatible address (Settings → AI model); images and media likewise, because notes link to any page.
# The microphone is this site's own, for Capture's Speak (agents-design D53); `microphone=()` had blocked it.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; font-src 'self'; connect-src 'self' https:; frame-src 'self' blob: https://challenges.cloudflare.com https://www.youtube-nocookie.com; worker-src 'self' blob:; object-src 'self' blob:; manifest-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), payment=()

# The manifest stays uncached, so a new name, icon or shortcut reaches installed apps at their next check. The service
# worker needs no rule: browsers fetch it past their cache whenever they look for a new version (src/update.ts), and
# Cloudflare's 4-hour browser cache on scripts replaces a no-cache here anyway (seen 2026-11-17).
/manifest.webmanifest
  Cache-Control: no-cache
